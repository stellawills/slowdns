[Unit]
Description=IPTunnel License Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=LICENSE_CONFIG=/opt/license-server/config.json
ExecStart=/usr/bin/python3 /opt/license-server/license_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
